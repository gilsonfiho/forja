# ============================================================
# WorkG — exemplo de configuração. Copie para .env e preencha.
# Nenhum valor real/secreto deve ser commitado (.env está no .gitignore).
# ============================================================

# ---- Aplicação ----
WORKG_ENV=development            # development | production
WORKG_LOG_LEVEL=INFO
WORKG_HOST=127.0.0.1
WORKG_PORT=8000

# ---- LLM (Claude / Anthropic) ----
WORKG_ANTHROPIC_API_KEY=
WORKG_LLM_MODEL=claude-opus-4-8  # modelo principal dos agents
WORKG_LLM_MAX_TOKENS=4096

# ---- RAG / Embeddings ----
# provider: local | voyage | openai
WORKG_EMBEDDINGS_PROVIDER=local
WORKG_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
WORKG_EMBEDDINGS_API_KEY=
# vector store: chroma | pgvector
WORKG_VECTOR_STORE=chroma
WORKG_CHROMA_PATH=.chroma
WORKG_KNOWLEDGE_BASE_PATH=knowledge_base
# usado apenas quando WORKG_VECTOR_STORE=pgvector
WORKG_PGVECTOR_DSN=

# ---- Jira (via MCP Atlassian ou API REST) ----
# backend: mcp | rest
WORKG_JIRA_BACKEND=mcp
WORKG_JIRA_BASE_URL=
WORKG_JIRA_EMAIL=
WORKG_JIRA_API_TOKEN=
WORKG_JIRA_DEFAULT_PROJECT=

# ---- Repositórios a analisar (raiz onde ficam os repos clonados) ----
WORKG_REPOS_ROOT=

# ---- NotebookLM (slides / infográficos) ----
WORKG_NOTEBOOKLM_ENABLED=false
WORKG_NOTEBOOKLM_NOTEBOOK_ID=
