# ============================================================
# Forja — exemplo de configuração. Copie para .env e preencha.
# Nenhum valor real/secreto deve ser commitado (.env está no .gitignore).
# ============================================================

# ---- Aplicação ----
FORJA_ENV=development            # development | production
FORJA_LOG_LEVEL=INFO
FORJA_HOST=127.0.0.1
FORJA_PORT=8000

# ---- LLM (Claude / Anthropic) ----
FORJA_ANTHROPIC_API_KEY=
FORJA_LLM_MODEL=claude-opus-4-8  # modelo principal dos agents
FORJA_LLM_MAX_TOKENS=4096

# ---- RAG / Embeddings ----
# provider: local | voyage | openai
FORJA_EMBEDDINGS_PROVIDER=local
FORJA_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
FORJA_EMBEDDINGS_API_KEY=
# vector store: chroma | pgvector
FORJA_VECTOR_STORE=chroma
FORJA_CHROMA_PATH=.chroma
FORJA_KNOWLEDGE_BASE_PATH=knowledge_base
# usado apenas quando FORJA_VECTOR_STORE=pgvector
FORJA_PGVECTOR_DSN=

# ---- Jira (via MCP Atlassian ou API REST) ----
# backend: mcp | rest
FORJA_JIRA_BACKEND=mcp
FORJA_JIRA_BASE_URL=
FORJA_JIRA_EMAIL=
FORJA_JIRA_API_TOKEN=
FORJA_JIRA_DEFAULT_PROJECT=

# ---- Repositórios a analisar (raiz onde ficam os repos clonados) ----
FORJA_REPOS_ROOT=

# ---- NotebookLM (slides / infográficos) ----
FORJA_NOTEBOOKLM_ENABLED=false
FORJA_NOTEBOOKLM_NOTEBOOK_ID=
